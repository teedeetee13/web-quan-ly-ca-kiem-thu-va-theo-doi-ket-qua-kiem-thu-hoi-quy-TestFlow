// Mô hình dữ liệu TestFlow — 8 thực thể theo đề cương (mục 2.5, Bảng 2).
// Tuần 3 cài đặt API cho User, Project, TestSuite, TestCase, TestStep.
// TestRun, RunCase, TestResult đã có bảng, API sẽ cài ở tuần 5 (WBS 2.6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TESTER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RunStatus {
  OPEN
  CLOSED
}

enum ResultStatus {
  UNTESTED // Chưa chạy
  PASSED // Đạt
  FAILED // Không đạt
  BLOCKED // Bị chặn
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  fullName     String
  passwordHash String
  role         Role     @default(TESTER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[]    @relation("ProjectCreator")
  createdCases TestCase[]   @relation("CaseCreator")
  updatedCases TestCase[]   @relation("CaseUpdater")
  runs         TestRun[]
  results      TestResult[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User        @relation("ProjectCreator", fields: [createdById], references: [id])
  suites    TestSuite[]
  cases     TestCase[]
  runs      TestRun[]
}

model TestSuite {
  id          Int      @id @default(autoincrement())
  projectId   Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id])
  cases   TestCase[]

  @@unique([projectId, name])
}

model TestCase {
  id            Int      @id @default(autoincrement())
  projectId     Int
  suiteId       Int
  code          String // Mã ca, duy nhất trong một dự án (VD: TC_LOGIN_02)
  title         String
  preconditions String?
  priority      Priority @default(MEDIUM)
  createdById   Int
  updatedById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id])
  suite     TestSuite  @relation(fields: [suiteId], references: [id])
  createdBy User       @relation("CaseCreator", fields: [createdById], references: [id])
  updatedBy User?      @relation("CaseUpdater", fields: [updatedById], references: [id])
  steps     TestStep[]
  runCases  RunCase[]

  @@unique([projectId, code])
  @@index([projectId, suiteId])
  @@index([projectId, priority])
}

model TestStep {
  id       Int    @id @default(autoincrement())
  caseId   Int
  order    Int
  action   String // Thao tác
  expected String // Kết quả mong đợi của bước

  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, order])
}

model TestRun {
  id          Int       @id @default(autoincrement())
  projectId   Int
  name        String
  version     String // Phiên bản phần mềm được kiểm thử
  status      RunStatus @default(OPEN)
  createdById Int
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  project   Project   @relation(fields: [projectId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  runCases  RunCase[]
}

// Bản chụp nội dung ca tại thời điểm tạo đợt: sửa/xoá ca gốc không làm đổi lịch sử.
model RunCase {
  id             Int      @id @default(autoincrement())
  runId          Int
  testCaseId     Int?
  code           String
  title          String
  preconditions  String?
  priority       Priority
  stepsSnapshot  Json // [{ order, action, expected }]
  createdAt      DateTime @default(now())

  run      TestRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  result   TestResult?

  @@unique([runId, testCaseId])
}

model TestResult {
  id           Int          @id @default(autoincrement())
  runCaseId    Int          @unique
  status       ResultStatus @default(UNTESTED)
  actualResult String?
  note         String?
  executedById Int?
  executedAt   DateTime?
  updatedAt    DateTime     @updatedAt

  runCase    RunCase @relation(fields: [runCaseId], references: [id], onDelete: Cascade)
  executedBy User?   @relation(fields: [executedById], references: [id])
}
